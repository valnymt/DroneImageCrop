# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# claude code runtime state (session-local, not shared config)
.claude/*.lock

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
/outputs/
/work/
/.npm-cache/

# python / backend
backend/.venv/
backend/**/__pycache__/
*.pyc

# training artifacts and model checkpoints (large binaries, don't commit)
backend/training/data/
backend/training/runs/
backend/training/weights/
models/**/*.pt
models/**/*.pth
backend/*.pt
backend/*.pth

backend/.venv311/
